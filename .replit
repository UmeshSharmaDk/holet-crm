modules = ["nodejs-24", "postgresql-16", "python-base-3.13", "java-graalvm22.3"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["jdk17"]

[userenv]

[userenv.production]
PASSWORD_RESET_URL_BASE = "https://crm.myindiatrips.com"

[objectStorage]
defaultBucketID = "replit-objstore-66787b68-85d2-4c83-9976-7edc4c6ac930"
